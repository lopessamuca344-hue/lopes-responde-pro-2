<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Lopes Responde Pro 2.0</title>

  <meta
    name="description"
    content="Lopes Responde Pro 2.0 — plataforma de inteligência artificial."
  >

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      background: #0b1020;
      color: #ffffff;
    }

    header {
      padding: 20px;
      border-bottom: 1px solid #252b40;
      background: #10172a;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
    }

    .version {
      margin-top: 5px;
      font-size: 13px;
      color: #9ca3af;
    }

    main {
      width: min(900px, 94%);
      margin: 40px auto;
    }

    .welcome {
      margin-bottom: 25px;
    }

    .welcome h1 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .welcome p {
      color: #aeb7ca;
      line-height: 1.6;
    }

    .chat {
      background: #111827;
      border: 1px solid #252b40;
      border-radius: 16px;
      overflow: hidden;
    }

    .messages {
      min-height: 300px;
      max-height: 500px;
      overflow-y: auto;
      padding: 20px;
    }

    .message {
      margin-bottom: 15px;
      padding: 14px;
      border-radius: 12px;
      line-height: 1.5;
    }

    .system {
      background: #172033;
      color: #cbd5e1;
    }

    .user {
      background: #1d4ed8;
      margin-left: 12%;
    }

    .assistant {
      background: #1f2937;
      margin-right: 12%;
    }

    .input-area {
      display: flex;
      gap: 10px;
      padding: 15px;
      border-top: 1px solid #252b40;
    }

    textarea {
      flex: 1;
      resize: none;
      min-height: 55px;
      max-height: 150px;
      padding: 15px;
      border: 1px solid #374151;
      border-radius: 10px;
      outline: none;
      background: #0b1020;
      color: #ffffff;
      font-size: 15px;
    }

    button {
      border: none;
      border-radius: 10px;
      padding: 0 22px;
      background: #2563eb;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #1d4ed8;
    }

    footer {
      padding: 30px;
      text-align: center;
      color: #6b7280;
      font-size: 13px;
    }

    @media (max-width: 600px) {
      .welcome h1 {
        font-size: 25px;
      }

      .input-area {
        flex-direction: column;
      }

      button {
        min-height: 48px;
      }

      .user {
        margin-left: 0;
      }

      .assistant {
        margin-right: 0;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">Lopes Responde Pro</div>
    <div class="version">Versão 2.0 — Novo Projeto</div>
  </header>

  <main>

    <section class="welcome">
      <h1>Olá! Eu sou o Lopes.</h1>

      <p>
        Bem-vindo ao Lopes Responde Pro 2.0.
        Esta é a base inicial da nova plataforma de inteligência artificial.
      </p>
    </section>

    <section class="chat">

      <div id="messages" class="messages">

        <div class="message system">
          Sistema iniciado com sucesso.
        </div>

        <div class="message assistant">
          Olá! O Lopes Responde Pro 2.0 está pronto para começar.
        </div>

      </div>

      <div class="input-area">

        <textarea
          id="userInput"
          placeholder="Digite sua mensagem..."
        ></textarea>

        <button id="sendButton">
          Enviar
        </button>

      </div>

    </section>

  </main>

  <footer>
    Lopes Responde Pro 2.0 — Projeto novo
  </footer>

  <script>

    const messages = document.getElementById("messages");
    const input = document.getElementById("userInput");
    const sendButton = document.getElementById("sendButton");

    function addMessage(text, type) {

      const message = document.createElement("div");

      message.className = `message ${type}`;

      message.textContent = text;

      messages.appendChild(message);

      messages.scrollTop = messages.scrollHeight;
    }

    function sendMessage() {

      const text = input.value.trim();

      if (!text) {
        return;
      }

      addMessage(text, "user");

      input.value = "";

      setTimeout(() => {

        addMessage(
          "Recebi sua mensagem. A conexão com o mecanismo de inteligência artificial será adicionada na próxima etapa.",
          "assistant"
        );

      }, 500);
    }

    sendButton.addEventListener("click", sendMessage);

    input.addEventListener("keydown", function(event) {

      if (event.key === "Enter" && !event.shiftKey) {

        event.preventDefault();

        sendMessage();

      }

    });

  </script>

</body>
</html>
